---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Formulier from '../components/Formulier.astro';

const alle = (await getCollection('tijdschriften')).sort((a, b) => +b.data.datum - +a.data.datum);
const stem = alle.filter((t) => t.data.reeks === 'de-stem');
const [laatste, ...archief] = stem;
const kinderblad = alle.find((t) => t.data.reeks === 'kinderblad');
---

<Base titel="De Stem" beschrijving="De Stem van Vervolgde Christenen: elke twee maanden gratis verhalen, nieuws en gebedspunten uit de vervolgde kerk.">
  <section class="kop-stem">
    <div class="wrap kop-raster">
      <div>
        <h1>De Stem</h1>
        <p class="inleiding">
          Ons tijdschrift <em>De Stem van Vervolgde Christenen</em> verschijnt elke twee maanden. Je leest er verhalen van broers en zussen in de vervolgde kerk, nieuws uit de projecten en concrete gebedspunten. Gratis, digitaal in je mailbox.
        </p>
        <ul class="waarom">
          <li>Je leert vervolgde christenen kennen via hun eigen verhaal.</li>
          <li>Je blijft op de hoogte van christenvervolging wereldwijd.</li>
          <li>Je weet waarvoor je kunt bidden en hoe je kunt helpen.</li>
        </ul>
        <div class="knoppen">
          {laatste && <a href={laatste.data.flipbook} class="knop knop-blauw" rel="noopener">Lees het nieuwste nummer</a>}
          <a href="#abonneren" class="knop knop-lijn">Ontvang De Stem gratis</a>
        </div>
      </div>
      {laatste && (
        <a href={laatste.data.flipbook} class="cover-groot" rel="noopener">
          <Image src={laatste.data.cover} alt={`Cover van De Stem, ${laatste.data.editie}: ${laatste.data.titel}`} widths={[360, 540, 720]} sizes="(max-width: 56rem) 70vw, 30vw" loading="eager" />
          <span class="cover-label">{laatste.data.editie}</span>
        </a>
      )}
    </div>
  </section>

  {kinderblad && (
    <section class="sectie kinder">
      <div class="wrap kinder-raster">
        <a href={kinderblad.data.flipbook} rel="noopener">
          <Image src={kinderblad.data.cover} alt={`Cover van het kinderblad: ${kinderblad.data.titel}`} width={320} />
        </a>
        <div>
          <h2>Voor kinderen: {kinderblad.data.titel}</h2>
          <p>Het kinderblad Stef, van onze Nederlandse zusterorganisatie SDOK, vertelt kinderen over leeftijdsgenoten die om hun geloof vervolgd worden.</p>
          <a href={kinderblad.data.flipbook} class="link-sterk" rel="noopener">Lees het kinderblad</a>
        </div>
      </div>
    </section>
  )}

  {archief.length > 0 && (
    <section class="sectie sectie-papier">
      <div class="wrap">
        <h2>Eerdere nummers</h2>
        <ul class="archief">
          {archief.map((t) => (
            <li>
              <a href={t.data.flipbook} rel="noopener">
                <Image src={t.data.cover} alt="" widths={[240, 400]} sizes="(max-width: 40rem) 45vw, 16rem" />
                <span class="editie">{t.data.editie}</span>
                <span class="titel">{t.data.titel}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="sectie" id="abonneren">
    <div class="wrap twee">
      <div>
        <h2>Ontvang De Stem gratis</h2>
        <p>We mailen je elke twee maanden het nieuwe nummer. De Stem verschijnt alleen nog digitaal, niet meer op papier. Je kunt je altijd weer uitschrijven.</p>
      </div>
      <Formulier naam="de-stem-abonnement" knop="Schrijf me in">
        <div class="rij">
          <div class="veld"><label for="s-naam">Naam</label><input id="s-naam" name="naam" type="text" required autocomplete="name" /></div>
          <div class="veld"><label for="s-email">E-mail</label><input id="s-email" name="email" type="email" required autocomplete="email" /></div>
        </div>
        <label class="keuze"><input type="checkbox" name="kinderblad" value="ja" /> Mail me ook het kinderblad Stef</label>
      </Formulier>
    </div>
  </section>
</Base>


<style>
  .kop-stem { background: var(--papier); padding-block: clamp(3rem, 7vw, 5.5rem); border-bottom: 6px solid var(--doorn); }
  .kop-raster { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .kop-stem h1 { font-size: clamp(3rem, 8vw, 6rem); letter-spacing: -0.04em; }
  .waarom { margin: 1.5rem 0 0; padding-left: 1.2em; max-width: 34em; }
  .waarom li { margin-bottom: 0.4rem; }
  .waarom li::marker { color: var(--doorn); }
  .cover-groot { display: block; position: relative; transform: rotate(2deg); transition: transform 0.2s; }
  .cover-groot:hover { transform: rotate(0); }
  .cover-groot img { width: 100%; box-shadow: 0 30px 50px -25px rgb(10 35 66 / 0.6); }
  .cover-label {
    position: absolute; left: -1rem; bottom: 2rem;
    background: var(--doorn); color: var(--wit);
    font-family: var(--kop); font-weight: 700; font-size: 0.9rem;
    padding: 0.5rem 0.9rem;
  }
  .kinder-raster { display: grid; grid-template-columns: 12rem 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; max-width: 56rem; }
  .kinder-raster img { width: 100%; box-shadow: 0 20px 35px -18px rgb(10 35 66 / 0.5); }
  .archief { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(45%, 12rem), 1fr)); gap: 2.5rem 2rem; }
  .archief a { text-decoration: none; color: var(--inkt); display: block; }
  .archief img { width: 100%; box-shadow: 0 16px 28px -16px rgb(10 35 66 / 0.5); margin-bottom: 1rem; transition: transform 0.2s; }
  .archief a:hover img { transform: translateY(-4px); }
  .editie { display: block; font-family: var(--kop); font-weight: 600; font-size: 0.85rem; color: var(--doorn); }
  .titel { display: block; font-family: var(--kop); font-weight: 700; font-size: 1rem; line-height: 1.3; }
  .archief a:hover .titel { color: var(--blauw); }
  .twee { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  @media (max-width: 56rem) {
    .kop-raster, .twee { grid-template-columns: 1fr; }
    .cover-groot { max-width: 18rem; }
    .kinder-raster { grid-template-columns: 8rem 1fr; }
  }
</style>
