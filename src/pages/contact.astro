---
import Base from '../layouts/Base.astro';
import PaginaKop from '../components/PaginaKop.astro';
import Formulier from '../components/Formulier.astro';
import { site } from '../data/site';
---

<Base titel="Contact" beschrijving="Neem contact op met Hulp aan de Verdrukte Kerk.">
  <PaginaKop titel="Contact" intro="Een vraag, een idee of een verhaal dat je wilt delen? We horen graag van je." />

  <section class="sectie">
    <div class="wrap twee">
      <div>
        <h2>Gegevens</h2>
        <address>
          <strong>{site.naam} {site.rechtsvorm}</strong><br />
          {site.adres.straat}<br />
          {site.adres.postcode} {site.adres.gemeente}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
        <p><a href={site.facebook} rel="noopener">HVK op Facebook</a></p>
        <p class="links">
          Wil je een presentatie aanvragen? Gebruik dan het formulier bij <a href="/doe-mee/nodig-ons-uit">Nodig ons uit</a>.<br />
          De Stem ontvangen? <a href="/de-stem#abonneren">Schrijf je hier in</a>.
        </p>
      </div>
      <div>
        <h2>Stuur een bericht</h2>
        <Formulier naam="contact" knop="Bericht versturen">
          <div class="rij">
            <div class="veld"><label for="c-naam">Naam</label><input id="c-naam" name="naam" type="text" required autocomplete="name" /></div>
            <div class="veld"><label for="c-email">E-mail</label><input id="c-email" name="email" type="email" required autocomplete="email" /></div>
          </div>
          <div class="veld"><label for="c-onderwerp">Onderwerp</label><input id="c-onderwerp" name="onderwerp" type="text" /></div>
          <div class="veld"><label for="c-bericht">Bericht</label><textarea id="c-bericht" name="bericht" required></textarea></div>
        </Formulier>
      </div>
    </div>
  </section>
</Base>

<style>
  .twee { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  address { font-style: normal; font-size: 1.1rem; margin-bottom: 1.25rem; }
  .links { color: var(--steen); font-size: 0.98rem; margin-top: 2rem; }
  @media (max-width: 56rem) { .twee { grid-template-columns: 1fr; } }
</style>
