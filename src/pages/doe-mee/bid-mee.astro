---
import Base from '../../layouts/Base.astro';
import PaginaKop from '../../components/PaginaKop.astro';
import { site } from '../../data/site';
import foto from '../../assets/foto/gevangene-gebed.webp';

const punten = [
  { tekst: 'Bid dat vervolgde christenen Gods nabijheid ervaren.', vers: 'Hebreeën 13:5' },
  { tekst: 'Bid dat ze zich verbonden weten met het wereldwijde lichaam van Christus.', vers: '1 Korintiërs 12:20, 26' },
  { tekst: 'Bid om Gods troost wanneer familieleden gedood, gewond of gevangengezet worden om hun getuigenis.', vers: '2 Korintiërs 1:3-5' },
  { tekst: 'Bid dat ze kansen krijgen om het evangelie te delen.', vers: 'Kolossenzen 4:3' },
  { tekst: 'Bid om moed om Christus bekend te maken.', vers: 'Filippenzen 1:14' },
  { tekst: 'Bid dat ze hun vervolgers liefhebben en vergeven.', vers: 'Matteüs 5:44' },
  { tekst: 'Bid dat hun werk verborgen blijft voor wie het willen vernietigen.', vers: 'Handelingen 9:25' },
  { tekst: 'Bid dat ze zich kunnen verblijden, ook in het lijden.', vers: 'Handelingen 5:41' },
  { tekst: 'Bid dat onze broers en zussen groeien in geloof en volharding.', vers: 'Romeinen 5:3-5' },
  { tekst: 'Bid dat ze gesterkt worden door de gebeden van andere gelovigen.', vers: 'Judas 20-21' },
];
---

<Base titel="Bid mee" beschrijving="Tien gebedspunten voor vervolgde christenen, en waar je elke week en elke twee maanden nieuwe gebedspunten vindt.">
  <PaginaKop
    titel="Bid mee"
    intro="We geloven dat gebed onmisbaar is om vervolgde christenen te steunen en te bemoedigen. Bid je mee voor onze broers en zussen die om hun geloof lijden?"
    foto={foto}
    fotoAlt="Een gewonde gevangene bidt met gevouwen handen in een cel"
    fotoPositie="50% 30%"
    donker
  />

  <section class="sectie">
    <div class="wrap twee">
      <div>
        <h2>Tien gebedspunten</h2>
        <p class="inleiding">Deze lijst groeide uit jarenlang contact met vervolgde christenen. Het is vooral wat zij ons leerden over gebed. Bewaar hem en gebruik hem in je dagelijkse gebed.</p>
      </div>
      <ol class="punten">
        {punten.map((p) => (
          <li>
            <p>{p.tekst}</p>
            <span class="vers">{p.vers}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sectie sectie-papier">
    <div class="wrap">
      <h2>Actuele gebedspunten</h2>
      <div class="bronnen">
        <div>
          <h3>Elke week</h3>
          <p>Op onze Facebookpagina delen we wekelijks concrete gebedspunten uit de vervolgde kerk.</p>
          <a href={site.facebook} class="link-sterk" rel="noopener">Volg HVK op Facebook</a>
        </div>
        <div>
          <h3>Elke twee maanden</h3>
          <p>In ons tijdschrift De Stem vind je bij elk verhaal gebedspunten. Je ontvangt het gratis.</p>
          <a href="/de-stem#abonneren" class="link-sterk">Ontvang De Stem</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .twee { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  .twee > div { position: sticky; top: 7rem; }
  .punten { list-style: none; counter-reset: punt; margin: 0; padding: 0; }
  .punten li {
    counter-increment: punt;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    column-gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--lijn);
  }
  .punten li::before {
    content: counter(punt);
    grid-row: span 2;
    font-family: var(--kop);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1.1;
    color: var(--doorn);
  }
  .punten p { font-size: 1.15rem; margin: 0 0 0.25rem; }
  .vers { font-family: var(--kop); font-size: 0.88rem; font-weight: 600; color: var(--steen); }
  .bronnen { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem 4rem; margin-top: 1.5rem; max-width: 56rem; }
  @media (max-width: 56rem) {
    .twee, .bronnen { grid-template-columns: 1fr; }
    .twee > div { position: static; }
  }
</style>
