---
// Toont een lokale miniatuur. YouTube (zonder cookies) laadt pas na een klik.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { id: string; titel: string; thumbnail: ImageMetadata }
const { id, titel, thumbnail } = Astro.props;
---

<div class="video" data-video={id} data-titel={titel}>
  <Image src={thumbnail} alt="" widths={[480, 800, 1280]} sizes="(max-width: 56rem) 100vw, 60vw" />
  <button type="button" class="video-play" aria-label={`Video afspelen: ${titel}`}>
    <svg viewBox="0 0 68 48" aria-hidden="true"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z" fill="currentColor"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
  </button>
  <p class="video-noot">Bij afspelen laadt YouTube de video.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.video[data-video]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.video}?autoplay=1&rel=0`;
      iframe.title = el.dataset.titel ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--nacht);
    border-radius: 4px;
    overflow: hidden;
  }
  .video :global(img), .video :global(iframe) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0;
  }
  .video-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(to top, rgb(10 35 66 / 0.45), transparent 60%);
    border: 0;
    cursor: pointer;
    color: var(--doorn);
  }
  .video-play svg { width: 4.5rem; transition: transform 0.15s; }
  .video-play:hover svg, .video-play:focus-visible svg { transform: scale(1.08); }
  .video-noot {
    position: absolute;
    left: 0.75rem;
    bottom: 0.5rem;
    margin: 0;
    font-family: var(--kop);
    font-size: 0.72rem;
    color: rgb(255 255 255 / 0.85);
    pointer-events: none;
  }
</style>
