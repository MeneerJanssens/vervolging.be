---
interface Props { wie: string; waar?: string; donker?: boolean }
const { wie, waar, donker = false } = Astro.props;
---

<figure class:list={['citaat', { donker }]}>
  <blockquote><slot /></blockquote>
  <figcaption><strong>{wie}</strong>{waar && <span>, {waar}</span>}</figcaption>
</figure>

<style>
  .citaat { margin: 0; max-width: 22em; position: relative; padding-top: 3.5rem; }
  .citaat::before {
    content: '“';
    position: absolute;
    top: -1.4rem;
    left: -0.3rem;
    font-family: var(--kop);
    font-weight: 800;
    font-size: 8rem;
    line-height: 1;
    color: var(--doorn);
  }
  .citaat blockquote {
    margin: 0;
    font-family: var(--kop);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.4vw, 2.7rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .citaat figcaption { margin-top: 1.25rem; font-size: 1rem; color: var(--steen); }
  .citaat figcaption strong { color: var(--inkt); font-family: var(--kop); }
  .citaat.donker figcaption { color: #9fb2c9; }
  .citaat.donker figcaption strong { color: var(--wit); }
</style>
